#!bin/bash

dnf update -y
dnf upgrade -y

dnf install -y amazon-efs-utils
dnf install -y python3 python3-pip

mkdir -p /mnt/mlflow
mount -t efs -o tls ${efs_id}:/ /mnt/mlflow

mkdir -p /mlflow
python3 -m venv /mlflow/venv
. /mflow/venv/bin/activate
pip install mlflow boto3 

dd if=/dev/zero of=/swapfile bs=2M count=1024
chmod 600 /swapfile
mkswap /swapfile
swapon /swapfile

cat << EOF > /etc/systemd/system/mlflow.service

[Unit]
Description=MLflow Tracking Server
After=network.target remote-fs.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
ExecStart=/mlflow/venv/bin/mlflow server --backend-store-uri sqlite:////mnt/mlflow/mlflow.db \
    --artifacts-destination s3://${bucket}/ --serve-artifacts --host 0.0.0.0 --port 5000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

EOF

systemctl daemon-reload
systemctl enable mlflow
systemctl start mlflow
